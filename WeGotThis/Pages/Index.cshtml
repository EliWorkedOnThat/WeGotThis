@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="text-center">
        <h1 class="display-4">Welcome @User.Identity.Name</h1>
    </div>
}
else
{
    <h1 class="display-4">Welcome</h1>
}

<div class="total-goal-counter">
    <h1>Goal Pool Currently: <span id="goalCounter" data-target="@Model.TotalGoals">0</span></h1>
    <p>Completed: <span class="count-completed">@Model.CompletedGoals</span> &nbsp;|&nbsp; Rejected: <span class="count-rejected">@Model.RejectedGoals</span></p>
</div>

<div class="new-goal">

    <div class="token-display">
        <span class="token-label">Tokens</span>
        <span class="token-count">@Model.Tokens</span>
    </div>

    <form method="post" asp-page-handler="SubmitGoal" class="goal-form">
        <input
            type="text"
            name="goalText"
            placeholder="What do you want to accomplish?"
            required />

        <button type="submit" disabled="@(Model.Tokens < 1)">
            + Goal
        </button>
    </form>
</div>

<div class="goal-list">
    <h2>Your Goal List for Today:</h2>

    @foreach (var goal in Model.RandomGoals)
    {
        bool completedByMe = Model.CompletedByMeIds.Contains(goal.Id);
        bool rejectedByMe = Model.RejectedByMeIds.Contains(goal.Id);

        <div class="goal-item @(completedByMe ? "goal-completed" : rejectedByMe ? "goal-rejected" : "")">

            <strong>@goal.Member?.Username</strong>: @goal.Goals

            <form method="post" asp-page-handler="Complete" asp-route-id="@goal.Id" style="display:inline;">
                <button type="submit" disabled="@(completedByMe || rejectedByMe)">
                    Complete
                </button>
            </form>

            <form method="post" asp-page-handler="Reject" asp-route-id="@goal.Id" style="display:inline;">
                <button type="submit" disabled="@(completedByMe || rejectedByMe)">
                    Reject
                </button>
            </form>

        </div>
    }
</div>

@if (Model.DailyQuote != null)
{
    <blockquote class="text-center my-4">
        <p class="fst-italic">"@Model.DailyQuote.Text"</p>
        <p class="text-muted">— @Model.DailyQuote.Author</p>
    </blockquote>
}